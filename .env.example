DJANGO_SECRET_KEY=YOUR_SECRET_KEY_HERE
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET_HERE
SIGNING_KEY_ENCRYPTION_KEY=YOUR_SIGNING_KEY_HERE
# Console is development output only. For inbox delivery select SMTP and configure your provider.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=VeriMeet <noreply@example.invalid>
EMAIL_HOST=smtp.example.invalid
EMAIL_PORT=587
EMAIL_HOST_USER=YOUR_SMTP_USERNAME
EMAIL_HOST_PASSWORD=YOUR_SMTP_PASSWORD
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false

# Explicit mode: production enables fail-closed SMTP and HTTPS-origin checks.
DJANGO_ENV=development
# Required in production; no path, credentials, query or fragment.
APPLICATION_ORIGIN=
EMAIL_FROM_NAME=VeriMeet
# Positive seconds, below the fixed 120-second worker lease.
EMAIL_TIMEOUT=20
